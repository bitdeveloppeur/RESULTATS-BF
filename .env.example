# RÉSULTATS-BF - Variables d'environnement
# Copier ce fichier en .env et remplacer les valeurs

# Configuration du groupe
GROUPE=8

# Nombre de serveurs applicatifs (minimum 2)
NB_APP=2

# Base de données PostgreSQL
DB_NAME=resultats_bf
DB_USER=resultats_user
DB_PASSWORD=changeme_db_password
DB_PORT=5432

# Réplication PostgreSQL
REPLICATION_USER=replication_user
REPLICATION_PASSWORD=changeme_replication_password

# Application
APP_PORT=3000
APP_SECRET=changeme_app_secret

# Load Balancer
LB_STATS_USER=admin
LB_STATS_PASSWORD=changeme_lb_password
